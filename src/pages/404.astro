---
import Base from '../layouts/Base.astro';
import { u } from '../utils';
---
<Base title="Not found">
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>Lost in the <span class="mark">gradient.</span></h1>
    <p class="muted">This page doesn't exist, or it moved.</p>
    <a class="btn btn-solid" href={u('/')}>Back home →</a>
  </section>
</Base>

<style>
  .nf { min-height: 70vh; display: grid; align-content: center; justify-items: start; gap: 16px; }
  h1 { font-size: clamp(2.8rem, 9vw, 6rem); }
</style>
