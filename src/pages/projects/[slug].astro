---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { u } from '../../utils';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}

const { project, next } = Astro.props;
const p = project.data;
const { Content } = await render(project);
const isWeb = p.kind === 'web';
const linkLabels = {
  live: p.kind === 'web' ? 'Visit website' : 'Try it live',
  github: 'View on GitHub',
  figma: 'Open in Figma',
} as const;
const links = Object.entries(p.links).filter(([, v]) => v) as [keyof typeof linkLabels, string][];
---
<Base title={p.title} description={p.summary}>
  <article>
    <header class="wrap head">
      <a href={u('/projects/')} class="eyebrow back">← All work</a>
      <p class="eyebrow">{p.year} · {p.subtitle}</p>
      <h1>{p.title}<span class="mark dot">.</span></h1>
      <p class="summary">{p.summary}</p>
      <dl class="facts">
        {p.role && (<div><dt class="eyebrow">Role</dt><dd>{p.role}</dd></div>)}
        <div><dt class="eyebrow">Year</dt><dd>{p.year}</dd></div>
        <div><dt class="eyebrow">Stack</dt><dd><ul class="chips">{p.tags.map((t) => <li class="chip">{t}</li>)}</ul></dd></div>
      </dl>
      {links.length > 0 && (
        <div class="links">
          {links.map(([k, href], i) => (
            <a class:list={['btn', { 'btn-solid': i === 0 }]} href={href} target="_blank" rel="noopener noreferrer">{linkLabels[k]} ↗</a>
          ))}
        </div>
      )}
    </header>

    <div class="stage">
      <span class="orb" aria-hidden="true"></span>
      <div class:list={['wrap', 'shots', p.kind]}>
        {(p.images.length ? p.images : [p.cover]).map((img, i) => (
          <Image
            src={img}
            alt={`${p.title} screenshot ${i + 1}`}
            widths={isWeb ? [600, 1000, 1500] : [240, 360, 520]}
            sizes={isWeb ? '(min-width: 1100px) 760px, 92vw' : '(min-width: 900px) 240px, 44vw'}
            loading={i < 2 ? 'eager' : 'lazy'}
            class="shot"
          />
        ))}
      </div>
    </div>

    <div class="wrap body">
      <aside class="outcome reveal">
        <p class="eyebrow">Key outcome</p>
        <p>{p.outcome}</p>
      </aside>
      <div class="prose reveal"><Content /></div>
    </div>

    <nav class="wrap next" aria-label="Next project">
      <a href={u(`/projects/${next.id}/`)}>
        <span class="eyebrow">Next project</span>
        <span class="next-title">{next.data.title} <span aria-hidden="true">→</span></span>
      </a>
    </nav>
  </article>
</Base>

<style>
  .head { padding-block: clamp(40px, 8vw, 96px) 48px; }
  .back { display: inline-block; margin-bottom: 40px; text-decoration: none; }
  .back:hover { color: var(--blue); }
  h1 { font-size: clamp(2.8rem, 7vw, 5rem); margin: 12px 0 20px; }
  .dot { padding: 0 0.05em; }
  .summary { font-size: clamp(1.15rem, 2.2vw, 1.45rem); max-width: 44ch; margin: 0 0 36px; }
  .facts { display: flex; flex-wrap: wrap; gap: 24px 48px; margin: 0 0 32px; }
  .facts dt { margin-bottom: 6px; }
  .facts dd { margin: 0; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; }

  .stage { position: relative; overflow: hidden; background: #1f4fb4; padding-block: clamp(40px, 7vw, 88px); isolation: isolate; }
  .orb {
    position: absolute; z-index: -1; width: min(70vw, 720px); aspect-ratio: 1; border-radius: 50%; right: -12%; bottom: -55%;
    background: radial-gradient(circle, #ff3d7f 0%, #f5b8c4 24%, #f3efd0 42%, transparent 70%);
  }
  .shots { display: flex; gap: clamp(12px, 2.5vw, 28px); justify-content: center; align-items: flex-start; flex-wrap: wrap; }
  .shot { border-radius: 14px; box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.6); }
  .mobile .shot, .design .shot { width: calc((100% - 3 * clamp(12px, 2.5vw, 28px)) / 4); min-width: 140px; }
  .wear { align-items: center; }
  .wear .shot { width: min(300px, calc(50% - 16px)); min-width: 0; aspect-ratio: 1; border-radius: 50%; object-fit: cover; box-shadow: 0 30px 60px -24px rgba(0, 0, 0, 0.6), 0 0 0 6px rgba(255, 255, 255, 0.08); }
  .web { align-items: center; }
  .web .shot:first-child { width: min(100%, 760px); border-radius: 10px; }
  .web .shot:not(:first-child) { width: min(30%, 240px); border-radius: 22px; }
  @media (max-width: 640px) {
    .mobile .shot, .design .shot { width: calc(50% - 8px); min-width: 0; }
    .web .shot:not(:first-child) { width: 46%; }
  }

  .body { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(32px, 6vw, 80px); padding-block: clamp(56px, 9vw, 112px); }
  .outcome { border-left: 3px solid var(--red); padding-left: 20px; align-self: start; position: sticky; top: 100px; }
  .outcome p:last-child { font-family: var(--serif); font-size: 1.45rem; line-height: 1.35; margin: 10px 0 0; }
  .prose { max-width: 62ch; }
  .prose :global(h2) { font-size: 1.9rem; margin: 1.6em 0 0.5em; }
  .prose :global(p:first-child) { margin-top: 0; }
  .prose :global(ul) { padding-left: 1.2em; }
  .prose :global(li) { margin-bottom: 0.5em; }
  .prose :global(li::marker) { color: var(--red); }
  .prose :global(strong) { font-weight: 600; }
  @media (max-width: 820px) {
    .body { grid-template-columns: 1fr; }
    .outcome { position: static; }
  }

  .next { padding-bottom: clamp(56px, 8vw, 96px); }
  .next a { display: grid; gap: 8px; padding-top: 32px; border-top: 1px solid var(--line); text-decoration: none; }
  .next-title { font-family: var(--serif); font-size: clamp(2.4rem, 7vw, 4.5rem); line-height: 1; }
  .next a:hover .next-title { color: var(--blue); }
</style>
