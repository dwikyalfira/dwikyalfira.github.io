---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { site, about } from '../data/site';
import { pexelsProfile } from '../data/gallery';
import { duolingoProfile } from '../data/duolingo';
import { u } from '../utils';

// schema.org Person, so search engines can connect the name to these profiles
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  email: `mailto:${site.email}`,
  image: `${site.url}/og.png`,
  sameAs: [...site.socials.map((s) => s.href), pexelsProfile, duolingoProfile],
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Politeknik Negeri Padang' },
  knowsLanguage: ['Indonesian', 'English', 'German'],
};

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base jsonLd={person}>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><div class="orb"></div></div>
    <div class="wrap hero-inner">
      <h1>
        Hi, I'm <span class="mark">Dwiky.</span><br />
        <em>Software engineer.</em>
      </h1>
      <p class="lede">{site.tagline}</p>
      <div class="actions">
        <a class="btn btn-solid" href={u('/projects/')}>See my work <span aria-hidden="true">→</span></a>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="work">
    <div class="section-head">
      <h2 id="work">Selected <span class="mark">work.</span></h2>
      <a href={u('/projects/')} class="eyebrow">All projects →</a>
    </div>
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <section class="section wrap about" aria-labelledby="about">
    <div class="section-head">
      <h2 id="about">A little <span class="mark">about.</span></h2>
      <a href={u('/about/')} class="eyebrow">More about me →</a>
    </div>
    <div class="cols">
      {about.highlights.map((h, i) => (
        <div class="col reveal" style={`transition-delay:${i * 90}ms`}>
          <span class="eyebrow">0{i + 1}</span>
          <h3>{h.title}</h3>
          <p class="muted">{h.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="gallery">
    <div class="section-head">
      <h2 id="gallery">Through my <span class="mark">lens.</span></h2>
      <a href={u('/gallery/')} class="eyebrow">Open gallery →</a>
    </div>
    <GalleryGrid limit={6} />
  </section>
</Base>

<script>
  // pause the orb animation while the hero is off-screen
  const hero = document.querySelector<HTMLElement>('.hero');
  if (hero) new IntersectionObserver(([e]) => hero.classList.toggle('paused', !e.isIntersecting)).observe(hero);
</script>

<style>
  .hero { position: relative; min-height: min(88vh, 820px); display: grid; align-items: center; isolation: isolate; }
  .hero-bg {
    position: absolute; inset: -68px 0 0; z-index: -1; overflow: hidden; pointer-events: none;
    --orb-mask: linear-gradient(to bottom, #000 70%, transparent 100%);
    -webkit-mask-image: var(--orb-mask);
    mask-image: var(--orb-mask);
  }
  .orb {
    --orb-size: min(72vw, 760px);
    --drift-x: -4vw;
    --drift-y: -5vh;
    position: absolute; border-radius: 50%;
    /* the core sits about two-thirds down the hero, clear of the headline */
    width: var(--orb-size); aspect-ratio: 1; right: -18vw; top: calc(66% - var(--orb-size) / 2); opacity: 0.9;
    background: radial-gradient(circle, var(--orb-a) 0%, var(--orb-b) 24%, var(--orb-c) 40%, color-mix(in srgb, var(--blue) 45%, transparent) 58%, transparent 70%);
    /* simple: fades in once, then breathes slowly */
    animation: orb-in 1.6s ease-out both, breathe 14s ease-in-out 1.6s infinite alternate;
    will-change: transform;
  }
  @keyframes orb-in {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 0.9; transform: scale(1); }
  }
  @keyframes breathe {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(var(--drift-x), var(--drift-y)) scale(1.06); }
  }
  .hero.paused .orb { animation-play-state: paused; }

  /* minimal entrance: hero content rises in once, slightly staggered */
  .hero-inner > * { animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
  .hero-inner > :nth-child(2) { animation-delay: 0.12s; }
  .hero-inner > :nth-child(3) { animation-delay: 0.24s; }
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  .hero-inner { padding-block: 72px; position: relative; }
  /* calmer, lower-key headline: smaller size, more air between lines */
  h1 { font-size: clamp(2.4rem, 5.4vw, 4.4rem); line-height: 1.12; max-width: 16ch; letter-spacing: -0.005em; }
  h1 .mark { padding: 0 0.1em; }
  h1 em { font-style: italic; color: var(--blue); }
  .lede { font-size: clamp(1.05rem, 2vw, 1.3rem); max-width: 42ch; color: var(--muted); margin: 28px 0 36px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }

  /* narrower screens: push the orb further off the right edge so its bright centre stays clear of the text */
  @media (max-width: 1100px) { .orb { right: -32vw; } }
  @media (max-width: 820px) { .orb { --orb-size: 60vw; } }

  /* phones: the hero sizes to its content so the first project shows on the first screen */
  @media (max-width: 640px) {
    .hero { min-height: 0; align-items: start; }
    .hero-inner { padding-block: 48px 16px; }
    /* no free space beside the text here, so the orb sits on the right edge just below the buttons */
    .hero-bg { bottom: -120px; --orb-mask: linear-gradient(to bottom, #000 calc(100% - 84px), transparent 100%); }
    .orb {
      --orb-size: clamp(200px, 64vw, 300px);
      --drift-x: -2vw;
      --drift-y: -10px;
      top: auto; right: calc(var(--orb-size) / -2); bottom: calc(84px - var(--orb-size) / 2);
    }
  }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 48px); }
  .grid > :global(:first-child) { grid-column: 1 / -1; }
  .grid > :global(:first-child .frame) { aspect-ratio: 2 / 1; }
  @media (max-width: 820px) { .grid > :global(:first-child .frame) { aspect-ratio: 16 / 11; } }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }

  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); }
  .col { padding: 28px 28px 8px 0; }
  .col + .col { padding-left: 28px; border-left: 1px solid var(--line); }
  .col h3 { font-size: 1.7rem; margin: 10px 0 8px; }
  @media (max-width: 820px) {
    .cols { grid-template-columns: 1fr; }
    .col, .col + .col { padding: 24px 0; border-left: 0; border-bottom: 1px solid var(--line); }
  }
</style>
