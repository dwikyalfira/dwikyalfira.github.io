---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import Marquee from '../components/Marquee.astro';
import { site, about } from '../data/site';
import { u } from '../utils';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"><div class="orb-follow"><div class="orb"></div></div></div>
    <div class="wrap hero-inner">
      <h1>
        Hi, I'm <span class="mark">Dwiky.</span><br />
        <em>Software engineer</em> who designs.
      </h1>
      <p class="lede">{site.tagline}</p>
      <div class="actions">
        <a class="btn btn-solid" href={u('/projects/')}>See my work <span aria-hidden="true">→</span></a>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="work">
    <div class="section-head">
      <h2 id="work">Selected <span class="mark">work.</span></h2>
      <a href={u('/projects/')} class="eyebrow">All projects →</a>
    </div>
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
    </div>
  </section>

  <Marquee />

  <section class="section wrap about" aria-labelledby="about">
    <div class="section-head">
      <h2 id="about">A little <span class="mark">about.</span></h2>
      <a href={u('/about/')} class="eyebrow">More about me →</a>
    </div>
    <div class="cols">
      {about.highlights.map((h, i) => (
        <div class="col reveal" style={`transition-delay:${i * 90}ms`}>
          <span class="eyebrow">0{i + 1}</span>
          <h3>{h.title}</h3>
          <p class="muted">{h.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="gallery">
    <div class="section-head">
      <h2 id="gallery">Through my <span class="mark">lens.</span></h2>
      <a href={u('/gallery/')} class="eyebrow">Open gallery →</a>
    </div>
    <GalleryGrid limit={6} />
  </section>
</Base>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const follow = hero?.querySelector<HTMLElement>('.orb-follow');
  if (hero && follow) {
    // pause the orb animation while the hero is off-screen
    new IntersectionObserver(([e]) => hero.classList.toggle('paused', !e.isIntersecting)).observe(hero);

    // gentle mouse parallax, mouse only, one rAF per move, no running loop
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (fine && !reduce) {
      let raf = 0, nx = 0, ny = 0;
      hero.addEventListener('pointermove', (e) => {
        const r = hero.getBoundingClientRect();
        nx = (e.clientX - r.left) / r.width - 0.5;
        ny = (e.clientY - r.top) / r.height - 0.5;
        if (!raf) raf = requestAnimationFrame(() => {
          follow.style.setProperty('--mx', `${(nx * 48).toFixed(1)}px`);
          follow.style.setProperty('--my', `${(ny * 48).toFixed(1)}px`);
          raf = 0;
        });
      });
      hero.addEventListener('pointerleave', () => {
        follow.style.setProperty('--mx', '0px');
        follow.style.setProperty('--my', '0px');
      });
    }
  }
</script>

<style>
  .hero { position: relative; min-height: min(88vh, 820px); display: grid; align-items: center; isolation: isolate; }
  .hero-bg {
    position: absolute; inset: -68px 0 0; z-index: -1; overflow: hidden; pointer-events: none;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }
  /* wrapper follows the mouse (set via --mx/--my); the orb inside drifts + morphs */
  .orb-follow {
    position: absolute; width: min(72vw, 760px); aspect-ratio: 1; right: -18vw; bottom: -36%;
    transform: translate3d(var(--mx, 0px), var(--my, 0px), 0);
    transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }
  .orb {
    width: 100%; height: 100%; border-radius: 50%; opacity: 0.9;
    /* closest-side so the colour reaches the edge and the morphing shape is visible */
    background: radial-gradient(circle closest-side, var(--orb-a) 0%, var(--orb-a) 8%, var(--orb-b) 30%, var(--orb-c) 50%, color-mix(in srgb, var(--blue) 42%, transparent) 76%, color-mix(in srgb, var(--blue) 10%, transparent) 96%);
    animation: drift 16s ease-in-out infinite alternate, morph 19s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes drift {
    from { transform: translate(0, 0) scale(1) rotate(0deg); }
    to { transform: translate(-6vw, -8vh) scale(1.08) rotate(25deg); }
  }
  @keyframes morph {
    0%, 100% { border-radius: 50%; }
    25% { border-radius: 44% 56% 52% 48% / 56% 44% 56% 44%; }
    50% { border-radius: 55% 45% 42% 58% / 46% 58% 42% 54%; }
    75% { border-radius: 47% 53% 58% 42% / 52% 46% 54% 48%; }
  }
  .hero.paused .orb { animation-play-state: paused; }
  .hero-inner { padding-block: 72px; position: relative; }
  h1 { font-size: clamp(3rem, 9.5vw, 7.4rem); max-width: 13ch; }
  h1 em { font-style: italic; color: var(--blue); }
  .lede { font-size: clamp(1.05rem, 2vw, 1.3rem); max-width: 42ch; color: var(--muted); margin: 28px 0 36px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(40px, 6vw, 72px) clamp(24px, 4vw, 48px); }
  .grid > :global(:first-child) { grid-column: 1 / -1; }
  .grid > :global(:first-child .frame) { aspect-ratio: 2 / 1; }
  @media (max-width: 820px) { .grid > :global(:first-child .frame) { aspect-ratio: 16 / 11; } }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }

  .cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border-top: 1px solid var(--line); }
  .col { padding: 28px 28px 8px 0; }
  .col + .col { padding-left: 28px; border-left: 1px solid var(--line); }
  .col h3 { font-size: 1.7rem; margin: 10px 0 8px; }
  @media (max-width: 820px) {
    .cols { grid-template-columns: 1fr; }
    .col, .col + .col { padding: 24px 0; border-left: 0; border-bottom: 1px solid var(--line); }
  }
</style>
