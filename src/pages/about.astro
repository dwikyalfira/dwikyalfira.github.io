---
import Base from '../layouts/Base.astro';
import { site, about, skills, strengths, experience } from '../data/site';
---
<Base title="About" description={`About ${site.name}: background, skills, and experience.`}>
  <section class="wrap page-head">
    <p class="eyebrow">About</p>
    <h1>Engineer by training,<br /><span class="mark">designer</span> at heart.</h1>
  </section>

  <section class="wrap intro">
    <div class="orb" aria-hidden="true"></div>
    <div class="text">
      {about.intro.map((p, i) => <p class:list={['reveal', { lead: i === 0 }]}>{p}</p>)}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="journey">
    <div class="section-head"><h2 id="journey">The <span class="mark">journey.</span></h2></div>
    <ol class="timeline">
      {experience.map((e) => (
        <li class="reveal">
          <span class="eyebrow period">{e.period}</span>
          <div>
            <h3>{e.title}</h3>
            <p class="org">{e.org}</p>
            <p class="muted">{e.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section wrap" aria-labelledby="toolkit">
    <div class="section-head"><h2 id="toolkit">The <span class="mark">toolkit.</span></h2></div>
    <div class="skills">
      {skills.map((s) => (
        <div class="reveal">
          <p class="eyebrow">{s.group}</p>
          <ul class="chips">{s.items.map((i) => <li class="chip">{i}</li>)}</ul>
        </div>
      ))}
    </div>
    <div class="strengths reveal">
      <p class="eyebrow">Strengths</p>
      <p class="list">{strengths.join(' · ')}</p>
      <p class="eyebrow">Languages</p>
      <p class="list">Indonesian (native) · English (professional)</p>
    </div>
  </section>
</Base>

<style>
  .page-head { padding-block: clamp(56px, 10vw, 120px) 32px; }
  .page-head h1 { font-size: clamp(2.8rem, 8vw, 6rem); margin-top: 16px; }
  .intro { position: relative; display: grid; grid-template-columns: 1fr 1.4fr; gap: 48px; padding-bottom: 24px; }
  .orb {
    aspect-ratio: 1; border-radius: 50%; align-self: start; position: sticky; top: 120px;
    background: radial-gradient(circle at 60% 65%, var(--orb-a) 0%, var(--orb-b) 22%, var(--orb-c) 40%, #1f4fb4 70%);
    animation: breathe 9s ease-in-out infinite alternate;
  }
  @keyframes breathe { to { transform: scale(0.94) rotate(12deg); border-radius: 46% 54% 50% 50%; } }
  .text p { margin: 0 0 1.2em; max-width: 60ch; }
  .lead { font-family: var(--serif); font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.3; }
  @media (max-width: 820px) {
    .intro { grid-template-columns: 1fr; }
    .orb { position: relative; top: 0; width: 55%; }
  }

  .timeline { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .timeline li { display: grid; grid-template-columns: 220px 1fr; gap: 24px; padding: 32px 0; border-bottom: 1px solid var(--line); }
  .timeline h3 { font-size: clamp(1.6rem, 3vw, 2.2rem); }
  .org { margin: 6px 0 10px; color: var(--blue); }
  .timeline .muted { margin: 0; max-width: 62ch; }
  .period { padding-top: 10px; }
  @media (max-width: 720px) { .timeline li { grid-template-columns: 1fr; gap: 8px; } }

  .skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; }
  .skills .eyebrow { margin: 0 0 12px; }
  .strengths { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--line); }
  .strengths .eyebrow { margin: 0 0 8px; }
  .list { font-family: var(--serif); font-size: clamp(1.3rem, 2.4vw, 1.75rem); line-height: 1.4; margin: 0 0 28px; }
</style>
