---
// Floating "back to top" button. Appears once the first screen has scrolled away.
// Uses an IntersectionObserver on a 1px sentinel (no scroll listeners).
---
<div class="top-sentinel" aria-hidden="true"></div>
<button type="button" class="to-top" aria-label="Back to top" title="Back to top">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" />
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.to-top');
  const sentinel = document.querySelector<HTMLElement>('.top-sentinel');
  if (btn && sentinel) {
    new IntersectionObserver(([e]) => btn.classList.toggle('show', !e.isIntersecting)).observe(sentinel);
    btn.addEventListener('click', (e) => {
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      // keyboard users (detail === 0): move focus back to the start of the page
      if (e.detail === 0) document.querySelector<HTMLElement>('.skip')?.focus({ preventScroll: true });
      else btn.blur();
    });
  }
</script>

<style>
  /* sits one screen down: once it scrolls out of view, the button shows */
  .top-sentinel { position: absolute; top: 100vh; left: 0; width: 1px; height: 1px; pointer-events: none; }

  .to-top {
    position: fixed; right: clamp(16px, 3vw, 28px); bottom: clamp(16px, 3vw, 28px); z-index: 60;
    display: grid; place-items: center; width: 46px; height: 46px;
    border-radius: 999px; border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    color: var(--ink); cursor: pointer;
    box-shadow: 0 10px 30px -16px rgba(15, 26, 51, 0.45);
    opacity: 0; transform: translateY(12px) scale(0.9); pointer-events: none;
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), border-color 0.2s, background-color 0.2s, color 0.2s, scale 160ms var(--ease-out);
  }
  .to-top:active { scale: var(--press-icon); }
  .to-top.show { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover { border-color: var(--ink); background: var(--ink); color: var(--bg); }
  .to-top:hover svg { transform: translateY(-2px); }
  .to-top svg { transition: transform 0.25s cubic-bezier(0.2, 0.7, 0.2, 1); }
</style>
