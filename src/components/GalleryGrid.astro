---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { captions } from '../data/gallery';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif}', {
  eager: true,
});
let photos = Object.entries(files)
  .sort(([a], [b]) => b.localeCompare(a))
  .map(([path, mod]) => {
    const name = path.split('/').pop()!;
    const c = captions[name] ?? {};
    return { name, img: mod.default, title: c.title, place: c.place };
  });
if (limit) photos = photos.slice(0, limit);

// Abstract placeholder tiles shown until real photos are added.
const placeholders = [
  { h: 1.25, a: '20% 80%', b: '#ff3d7f' },
  { h: 0.8, a: '80% 20%', b: '#f3efd0' },
  { h: 1.05, a: '50% 100%', b: '#ff7a59' },
  { h: 1.3, a: '0% 0%', b: '#f5b8c4' },
  { h: 0.9, a: '100% 60%', b: '#ff3d7f' },
  { h: 1.15, a: '30% 30%', b: '#f3efd0' },
].slice(0, limit ?? 6);
---
{photos.length > 0 ? (
  <div class="masonry" data-gallery>
    {photos.map((p, i) => (
      <figure class="item reveal">
        <button type="button" class="open" data-index={i} aria-label={`Open photo${p.title ? `: ${p.title}` : ''}`}>
          <Image
            src={p.img}
            alt={p.title ?? 'Photograph'}
            widths={[400, 700, 1000]}
            sizes="(min-width: 1000px) 360px, (min-width: 640px) 46vw, 92vw"
            loading="lazy"
            data-full={p.img.src}
          />
        </button>
        {(p.title || p.place) && (
          <figcaption>
            {p.title && <span>{p.title}</span>}
            {p.place && <span class="eyebrow">{p.place}</span>}
          </figcaption>
        )}
      </figure>
    ))}
  </div>
) : (
  <div class="masonry">
    {placeholders.map((p, i) => (
      <div
        class="ph reveal"
        style={`aspect-ratio:1/${p.h};background:radial-gradient(circle at ${p.a}, ${p.b} 0%, #f3efd0 30%, #1f4fb4 72%);transition-delay:${i * 60}ms`}
        aria-hidden="true"
      >
      </div>
    ))}
    <p class="empty eyebrow">Photographs coming soon.</p>
  </div>
)}

<dialog class="lightbox" aria-label="Photo viewer">
  <img alt="" />
  <p class="cap"></p>
  <button type="button" class="nav prev" aria-label="Previous photo">←</button>
  <button type="button" class="nav next" aria-label="Next photo">→</button>
  <button type="button" class="close" aria-label="Close">✕</button>
</dialog>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  if (grid && dlg) {
    const buttons = [...grid.querySelectorAll<HTMLButtonElement>('.open')];
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector<HTMLElement>('.cap')!;
    let cur = 0;
    const show = (i: number) => {
      cur = (i + buttons.length) % buttons.length;
      const src = buttons[cur].querySelector('img')!;
      img.src = src.dataset.full ?? src.currentSrc;
      img.alt = src.alt;
      const fc = buttons[cur].parentElement?.querySelector('figcaption');
      cap.textContent = fc ? fc.textContent?.trim().replace(/\s+/g, ' · ') ?? '' : '';
    };
    buttons.forEach((b, i) => b.addEventListener('click', () => { show(i); dlg.showModal(); }));
    dlg.querySelector('.prev')!.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('.next')!.addEventListener('click', () => show(cur + 1));
    dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(cur - 1);
      if (e.key === 'ArrowRight') show(cur + 1);
    });
  }
</script>

<style>
  .masonry { columns: 3 280px; column-gap: 16px; position: relative; }
  .item, .ph { break-inside: avoid; margin: 0 0 16px; }
  .ph { border-radius: var(--radius); width: 100%; opacity: 0.85; }
  .open { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: var(--radius); overflow: hidden; }
  .open :global(img) { width: 100%; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s; }
  .open:hover :global(img) { transform: scale(1.04); }
  figcaption { display: flex; justify-content: space-between; gap: 12px; padding-top: 8px; font-size: 0.9rem; }
  .empty { column-span: all; text-align: center; margin: 8px 0 0; }

  .lightbox {
    max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; padding: 0;
    border: 0; background: rgba(6, 10, 22, 0.94); color: #fff;
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: 92vw; max-height: 82vh; object-fit: contain; border-radius: 6px; }
  .cap { position: absolute; bottom: 20px; left: 0; right: 0; text-align: center; margin: 0; font-size: 0.9rem; opacity: 0.8; }
  .lightbox button {
    position: absolute; width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.06); color: #fff; font-size: 1.1rem; cursor: pointer;
  }
  .lightbox button:hover { background: rgba(255, 255, 255, 0.16); }
  .close { top: 16px; right: 16px; }
  .prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .next { right: 16px; top: 50%; transform: translateY(-50%); }
</style>
