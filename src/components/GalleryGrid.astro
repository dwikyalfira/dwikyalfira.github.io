---
import { getImage } from 'astro:assets';
import { getPhotos, pexelsSrc, pexelsPage, pexelsProfile } from '../data/gallery';

interface Props {
  limit?: number;
}
const { limit } = Astro.props;
const all = await getPhotos();
const list = limit ? all.slice(0, limit) : all;

// Download each photo from Pexels once at build time and serve resized WebP copies
// from this site: faster, and no third-party (Cloudflare) cookies for visitors.
const WIDTHS = [400, 700, 1000, 1400];
const photos = await Promise.all(
  list.map(async (p) => {
    const src = pexelsSrc(p.id, 1800);
    const size = (width: number) => ({ width, height: Math.round((width * p.h) / p.w) });
    const [sized, full] = await Promise.all([
      Promise.all(WIDTHS.map((w) => getImage({ src, ...size(w), format: 'webp' }))),
      getImage({ src, ...size(1800), format: 'webp', quality: 82 }),
    ]);
    return {
      ...p,
      src: sized[1].src,
      srcset: sized.map((img, k) => `${img.src} ${WIDTHS[k]}w`).join(', '),
      full: full.src,
    };
  }),
);
// on the gallery page the first row is above the fold: load it right away
const eager = (i: number) => !limit && i < 3;
---
<div class:list={['masonry', { preview: !!limit }]} data-gallery>
  {photos.map((p, i) => (
    <figure
      class="item reveal"
      data-size={p.pxW && p.pxH ? `${p.pxW} × ${p.pxH}` : undefined}
      data-page={pexelsPage(p.id)}
    >
      <button type="button" class="open" data-index={i} aria-label={`Open photo: ${p.title}`} style={p.avgColor ? `background:${p.avgColor}` : undefined}>
        <img
          src={p.src}
          srcset={p.srcset}
          sizes={limit ? '(min-width: 1000px) 360px, 46vw' : '(min-width: 1000px) 360px, (min-width: 640px) 46vw, 92vw'}
          width={p.w * 100}
          height={p.h * 100}
          alt={p.title}
          loading={eager(i) ? 'eager' : 'lazy'}
          fetchpriority={i === 0 && eager(i) ? 'high' : undefined}
          decoding="async"
          data-full={p.full}
        />
      </button>
      <figcaption>
        <span>{p.title}</span>
        {p.place && <span class="eyebrow">{p.place}</span>}
      </figcaption>
    </figure>
  ))}
</div>

<dialog class="lightbox" aria-label="Photo viewer">
  <img alt="" />
  <div class="lens" aria-hidden="true"></div>
  <div class="cap">
    <p class="cap-title"></p>
    <p class="info"><span class="size"></span><a class="src" href={pexelsProfile} target="_blank" rel="noopener noreferrer">View on Pexels ↗</a></p>
  </div>
  <p class="hint">Click or tap the photo to magnify<span class="swipe-hint"> · swipe to browse</span></p>
  <button type="button" class="nav prev" aria-label="Previous photo">←</button>
  <button type="button" class="nav next" aria-label="Next photo">→</button>
  <button type="button" class="close" aria-label="Close">✕</button>
</dialog>

<script>
  const grid = document.querySelector<HTMLElement>('[data-gallery]');
  const dlg = document.querySelector<HTMLDialogElement>('.lightbox');
  if (grid && dlg) {
    const buttons = [...grid.querySelectorAll<HTMLButtonElement>('.open')];
    const img = dlg.querySelector('img')!;
    const capTitle = dlg.querySelector<HTMLElement>('.cap-title')!;
    const size = dlg.querySelector<HTMLElement>('.info .size')!;
    const srcLink = dlg.querySelector<HTMLAnchorElement>('.info .src')!;
    let cur = 0;
    const show = (i: number) => {
      cur = (i + buttons.length) % buttons.length;
      const src = buttons[cur].querySelector('img')!;
      img.src = src.dataset.full ?? src.currentSrc;
      img.alt = src.alt;
      const fc = buttons[cur].parentElement?.querySelector('figcaption');
      capTitle.textContent = fc ? [...fc.children].map((c) => c.textContent?.trim()).filter(Boolean).join(' · ') : '';
      const d = buttons[cur].closest<HTMLElement>('figure')?.dataset ?? {};
      size.textContent = d.size ? `${d.size} px` : '';
      size.hidden = !d.size;
      srcLink.href = d.page ?? '#';
    };
    // ---- magnifier: click the photo to toggle a lens that follows the pointer ----
    const lens = dlg.querySelector<HTMLElement>('.lens')!;
    const ZOOM = 2.5;
    let magnifying = false, raf = 0, px = 0, py = 0;
    const placeLens = () => {
      raf = 0;
      const r = img.getBoundingClientRect();
      const x = px - r.left, y = py - r.top;
      if (x < 0 || y < 0 || x > r.width || y > r.height) { lens.classList.remove('on'); return; }
      const half = lens.offsetWidth / 2;
      lens.style.transform = `translate(${px - half}px, ${py - half}px)`;
      lens.style.backgroundSize = `${r.width * ZOOM}px ${r.height * ZOOM}px`;
      lens.style.backgroundPosition = `${-(x * ZOOM - half)}px ${-(y * ZOOM - half)}px`;
      lens.classList.add('on');
    };
    const setMagnify = (on: boolean, e?: PointerEvent | MouseEvent) => {
      magnifying = on;
      dlg.classList.toggle('magnifying', on);
      if (on && e) {
        lens.style.backgroundImage = `url("${img.currentSrc || img.src}")`;
        px = e.clientX; py = e.clientY; placeLens();
      } else lens.classList.remove('on');
    };
    let swiped = false;
    img.addEventListener('click', (e) => {
      if (swiped) { swiped = false; return; } // a swipe ends with a click on some devices
      setMagnify(!magnifying, e);
    });
    dlg.addEventListener('pointermove', (e) => {
      if (!magnifying) return;
      px = e.clientX; py = e.clientY;
      if (!raf) raf = requestAnimationFrame(placeLens);
    });

    // lock page scroll while the viewer is open (and keep layout from shifting when the scrollbar disappears)
    const root = document.documentElement;
    const lockScroll = () => {
      const bar = innerWidth - root.clientWidth;
      root.style.overflow = 'hidden';
      if (bar > 0) root.style.paddingRight = `${bar}px`;
    };
    const unlockScroll = () => {
      root.style.overflow = '';
      root.style.paddingRight = '';
    };

    buttons.forEach((b, i) => b.addEventListener('click', () => { setMagnify(false); show(i); lockScroll(); dlg.showModal(); }));
    dlg.querySelector('.prev')!.addEventListener('click', () => { setMagnify(false); show(cur - 1); });
    dlg.querySelector('.next')!.addEventListener('click', () => { setMagnify(false); show(cur + 1); });
    dlg.querySelector('.close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('close', () => { setMagnify(false); unlockScroll(); });
    // swallow wheel/touch scrolling inside the viewer so it never reaches the page
    dlg.addEventListener('wheel', (e) => e.preventDefault(), { passive: false });
    dlg.addEventListener('touchmove', (e) => e.preventDefault(), { passive: false });

    // swipe left/right on touch screens to change photo (disabled while the magnifier is on)
    const slide = (dir: 1 | -1) => {
      setMagnify(false);
      show(cur + dir);
      img.classList.remove('from-left', 'from-right');
      void img.offsetWidth; // restart the animation
      img.classList.add(dir === 1 ? 'from-right' : 'from-left');
    };
    let sx = 0, sy = 0, st = 0, tracking = false;
    dlg.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || magnifying || (e.target as Element).closest('button, a')) return;
      tracking = true; sx = e.clientX; sy = e.clientY; st = performance.now();
    });
    dlg.addEventListener('pointerup', (e) => {
      if (!tracking) return;
      tracking = false;
      const dx = e.clientX - sx, dy = e.clientY - sy;
      const fast = performance.now() - st < 600;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5 && fast) {
        swiped = true;
        setTimeout(() => (swiped = false), 400);
        slide(dx < 0 ? 1 : -1);
      }
    });
    dlg.addEventListener('pointercancel', () => (tracking = false));
    dlg.addEventListener('click', (e) => { if (e.target === dlg && !swiped) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { setMagnify(false); show(cur - 1); }
      if (e.key === 'ArrowRight') { setMagnify(false); show(cur + 1); }
    });
  }
</script>

<style>
  .masonry { columns: 3 280px; column-gap: 16px; position: relative; }
  .item { break-inside: avoid; margin: 0 0 16px; }
  .open { display: block; width: 100%; padding: 0; border: 0; background: color-mix(in srgb, var(--blue) 12%, var(--bg)); cursor: zoom-in; border-radius: var(--radius); overflow: hidden; }
  .open :global(img) { width: 100%; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1), filter 0.4s; }
  .open:hover :global(img) { transform: scale(1.04); }
  figcaption { display: flex; justify-content: space-between; gap: 12px; padding-top: 8px; font-size: 0.9rem; }
  /* home page preview on phones: two columns keep the page short before contact */
  @media (max-width: 640px) {
    .masonry.preview { columns: 2; column-gap: 12px; }
    .preview .item { margin-bottom: 14px; }
    .preview figcaption { flex-direction: column; gap: 2px; }
  }

  .lightbox {
    overscroll-behavior: contain;
    touch-action: none; /* we handle swipes ourselves */
    /* layout lives here, not on [open]: position and flex must hold while the fade-out plays */
    position: fixed; inset: 0;
    max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; padding: 56px 16px 24px;
    flex-direction: column; align-items: center; justify-content: center; gap: 14px;
    border: 0; background: rgba(6, 10, 22, 0.94); color: #fff;
    opacity: 0;
    transition: opacity 200ms var(--ease-out), overlay 200ms allow-discrete, display 200ms allow-discrete;
  }
  .lightbox[open] { display: flex; opacity: 1; }
  @starting-style { .lightbox[open] { opacity: 0; } }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: min(92vw, 100%); max-height: calc(100vh - 200px); object-fit: contain; border-radius: 6px; cursor: zoom-in; transform: scale(0.97); transition: transform 200ms var(--ease-out); }
  .lightbox[open] img { transform: none; }
  @starting-style { .lightbox[open] img { transform: scale(0.97); } }
  .lightbox.magnifying img { cursor: zoom-out; touch-action: none; }
  .lightbox img.from-right { animation: from-right 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .lightbox img.from-left { animation: from-left 0.35s cubic-bezier(0.2, 0.7, 0.2, 1); }
  @keyframes from-right { from { opacity: 0; transform: translateX(40px); } }
  @keyframes from-left { from { opacity: 0; transform: translateX(-40px); } }

  /* magnifier lens */
  .lens {
    position: fixed; left: 0; top: 0; z-index: 2;
    width: clamp(140px, 22vw, 220px); aspect-ratio: 1; border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(0, 0, 0, 0.2);
    background-repeat: no-repeat; background-color: #0a0f1e;
    pointer-events: none; opacity: 0; scale: 0.6;
    transition: opacity 0.2s ease, scale 0.25s cubic-bezier(0.2, 0.7, 0.2, 1);
    will-change: transform;
  }
  .lens.on { opacity: 1; scale: 1; }
  .hint {
    position: absolute; top: 24px; left: 0; right: 0; margin: 0; text-align: center;
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5;
    transition: opacity 0.3s;
  }
  .lightbox.magnifying .hint { opacity: 0; }
  .swipe-hint { display: none; }
  @media (hover: none) and (pointer: coarse) { .swipe-hint { display: inline; } }
  .cap { max-width: 640px; text-align: center; }
  .cap p { margin: 0; }
  .cap-title { font-size: 0.95rem; opacity: 0.9; }
  .info {
    margin-top: 6px !important; display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
    font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em;
  }
  .info .size { opacity: 0.6; }
  .info .src { color: #fff; opacity: 0.8; text-decoration: none; border-bottom: 1px solid rgba(255, 255, 255, 0.35); }
  .info .src:hover { opacity: 1; }
  .lightbox button {
    position: absolute; width: 44px; height: 44px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.06); color: #fff; font-size: 1.1rem; cursor: pointer;
    transition: scale 160ms var(--ease-out);
  }
  .lightbox button:active { scale: var(--press-icon); }
  .lightbox button:hover { background: rgba(255, 255, 255, 0.16); }
  .close { top: 16px; right: 16px; }
  .prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .next { right: 16px; top: 50%; transform: translateY(-50%); }

  /* reduced motion: keep a short fade (it isn't movement), drop the scale */
  @media (prefers-reduced-motion: reduce) {
    .lightbox { transition: opacity 150ms ease, overlay 150ms allow-discrete, display 150ms allow-discrete !important; }
    .lightbox img { transform: none; }
  }
</style>
