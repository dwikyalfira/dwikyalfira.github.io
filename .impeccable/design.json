  "narrative": {
    "northStar": "The Warm Signal",
    "overview": "A plain, quiet surface with one warm source of light on it. Blue is the identity and paper is the room; the pink-to-cream orb is the small sign that a person is behind the page. It comes straight from the owner's portfolio document, where a field of blue holds a single glow in the corner.\n\nThe system is low-key by intent. Large serif headlines do the talking, a single red marker picks out one word, and everything else stays out of the way. Density is low and the pages breathe. Components are soft and tactile: they rest flat, then lift when approached and give slightly when pressed.\n\nMotion is small and has a job. The owner has rejected moving text marquees, 3D tilt on cards, mouse-following effects, and JavaScript cursors that feel heavy, and those rejections are part of the system.",
    "keyCharacteristics": [
      "Blue carries the identity; paper and ink carry the reading.",
      "One red marker per heading, one orb per section.",
      "Serif display over a humanist sans, with monospace for small labels.",
      "Flat at rest, tactile on interaction.",
      "A light film grain over everything, in both themes.",
      "Light and dark themes share the same structure."
    ],
    "rules": [
      {
        "name": "The Blue Identity Rule",
        "body": "When a surface needs to feel like Dwiky's, it turns blue. Red and the orb support blue; they never replace it as the large field.",
        "section": "colors"
      },
      {
        "name": "The One Marker Rule",
        "body": "A heading carries at most one red marker, on one word or number. If two things are highlighted, neither is.",
        "section": "colors"
      },
      {
        "name": "The One Orb Rule",
        "body": "A section or frame holds at most one orb. It is a light source, not a pattern.",
        "section": "colors"
      },
      {
        "name": "The Weight Comes From Size Rule",
        "body": "Headlines stay at weight 400. Hierarchy comes from size and the serif, never from bolding.",
        "section": "typography"
      },
      {
        "name": "The Monospace Is Small Rule",
        "body": "JetBrains Mono never appears above label size.",
        "section": "typography"
      },
      {
        "name": "The Flat-At-Rest Rule",
        "body": "Interface surfaces carry no shadow until touched. Screenshots are content, so they are exempt.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Signal Blue for any large identity surface, such as project frames.",
      "Do limit each heading to one Marker Red word or number.",
      "Do keep headlines at weight 400 and build hierarchy through size.",
      "Do keep surfaces flat at rest, and let them lift on hover and give on press.",
      "Do use 1px Hairline borders for structure instead of filled panels.",
      "Do keep motion short and functional, and respect reduced-motion preferences.",
      "Do define colours for both light and dark themes."
    ],
    "donts": [
      "Don't add moving text marquees, 3D tilt on cards, or mouse-following effects.",
      "Don't add JavaScript-driven custom cursors. The cursor is a lightweight CSS image.",
      "Don't animate imagery inside a card; only the card itself moves.",
      "Don't use a portrait of the owner anywhere in the design.",
      "Don't put letters back in the logo.",
      "Don't make display headlines louder than the current scale.",
      "Don't use the orb colours as flat fills or text."
    ]
  }
}
